    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PSWorkshopUploader</AssemblyName>
    <RootNamespace>PSWorkshopUploader</RootNamespace>
